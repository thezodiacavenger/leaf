{
  "name": "leaf",
  "version": "0.3.1",
  "description": "Drop anything on the leaf: a calm Windows desktop assistant that converts photos, RAW, HEIC, emails, PDFs and Office files locally.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64",
    "prebuild": "npm install --no-save --force --os=win32 --cpu=x64 exiftool-vendored.exe@$(node -p \"require('exiftool-vendored/package.json').optionalDependencies['exiftool-vendored.exe']\")",
    "test": "electron --no-sandbox tests/unit.js"
  },
  "author": "Emmet Adriaans",
  "license": "MIT",
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@kenjiuno/decompressrtf": "0.1.4",
    "@kenjiuno/msgreader": "1.29.0",
    "exiftool-vendored": "39.0.1",
    "heic-decode": "^2.1.0",
    "libraw-wasm": "^1.6.0",
    "pdfjs-dist": "6.4.299",
    "postal-mime": "4.1.3",
    "rtf-stream-parser": "4.0.0",
    "utif": "^3.1.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "^25.1.8"
  },
  "productName": "Leaf",
  "build": {
    "appId": "ca.eadriaans.leaf",
    "productName": "Leaf",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.{map,d.ts,d.mts,md,markdown,ts}",
      "!**/{README,CHANGELOG,HISTORY,AUTHORS}*",
      "!**/{test,tests,__tests__,docs,example,examples}/**",
      "!node_modules/pdfjs-dist/**",
      "node_modules/pdfjs-dist/package.json",
      "node_modules/pdfjs-dist/legacy/build/pdf.min.mjs",
      "node_modules/pdfjs-dist/legacy/build/pdf.worker.min.mjs",
      "!node_modules/@cantoo/pdf-lib/{es,dist,src,ts3.4}/**",
      "!node_modules/libheif-js/libheif/**",
      "!node_modules/libheif-js/libheif-wasm/{libheif.js,libheif.wasm,libheif-bundle.mjs}",
      "!node_modules/libraw-wasm/dist/*.map",
      "!node_modules/@napi-rs/**",
      "!**/exiftool-vendored.pl/**"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Leaf-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Leaf-${version}-portable.exe"
    },
    "asarUnpack": [
      "src/engine/heic-worker.js",
      "node_modules/heic-decode/**",
      "node_modules/libheif-js/**",
      "**/exiftool-vendored.exe/**",
      "**/exiftool-vendored.pl/**",
      "node_modules/libraw-wasm/**"
    ],
    "electronLanguages": [
      "en-US",
      "fr"
    ],
    "afterPack": "build/after-pack.js",
    "copyright": "© 2026 Emmet Adriaans"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thezodiacavenger/leaf.git"
  },
  "homepage": "https://github.com/thezodiacavenger/leaf#readme",
  "bugs": {
    "url": "https://github.com/thezodiacavenger/leaf/issues"
  },
  "keywords": [
    "windows",
    "electron",
    "converter",
    "heic",
    "raw",
    "pdf",
    "outlook",
    "msg",
    "desktop-assistant",
    "privacy"
  ]
}
