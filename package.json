{
  "name": "leaf",
  "version": "0.1.0",
  "description": "Drop anything. Leaf converts it.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64"
  },
  "author": "Vistek Ltd",
  "license": "UNLICENSED",
  "dependencies": {
    "heic-decode": "^2.1.0",
    "pdf-lib": "^1.17.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "productName": "Leaf",
  "build": {
    "appId": "ca.vistek.leaf",
    "productName": "Leaf",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Leaf-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Leaf-${version}-portable.exe"
    },
    "asarUnpack": [
      "src/engine/heic-worker.js",
      "node_modules/heic-decode/**",
      "node_modules/libheif-js/**"
    ]
  }
}